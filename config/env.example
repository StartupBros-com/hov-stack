# <overlay>/env: NAME=value lines that claude-env.sh exports before each Bash call.
# The shell sources it, so quote a value with spaces and $HOME expands. Every command a
# session runs sees these values, so prefer a secret store over a token here.
MY_API_BASE=https://api.example.invalid
MY_TOOL_STATE_DIR=$HOME/.local/state/my-tool

# A systemd unit runs without this file in its environment, so a scheduled script that
# needs a value here reads it itself, through lib/overlay.sh. update-mcp-servers.sh
# (mcp-servers-update.timer) refuses to run without this one: the GitHub origin its
# checkout must match. Uncomment it and fill in the placeholder.
# HOV_MCP_EXPECTED_ORIGIN=owner/repo
