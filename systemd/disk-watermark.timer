# TEMPLATE: Hourly trigger for disk-watermark.service.
# Replace before enabling:
#   nothing; the defaults are generic.
# See systemd/README.md.
[Unit]
Description=Hourly disk-fill watermark check

[Timer]
# Hourly, randomized: this watches the one resource every other hygiene timer
# (wt-sweep, reclaim-sweep, docker-hygiene, pkg-cache-prune) assumes plenty of
# -- the disk itself. The 2026-08-21 emergency-reset incident happened because
# nothing did. Daily was too slow: on 2026-11-14 agent worktrees took 22.5 GiB
# of the root disk in three hours (hov-stack#644). The script alerts only when
# a breach is new or worse than at its last alert, so a disk that stays full
# does not toast every hour, and the check is two `df` calls. Minute 23 keeps
# it off the :00 pile-up of other hourly jobs.
OnCalendar=*-*-* *:23:00
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
