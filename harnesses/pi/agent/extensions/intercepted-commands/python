#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
real_path="$(printf '%s' "$PATH" | awk -v RS=: -v ORS=: -v dir="$script_dir" '$0 != dir { print }' | sed 's/:$//')"
real_python="$(PATH="$real_path" command -v python || true)"
if [ -z "$real_python" ]; then
  real_python="$(PATH="$real_path" command -v python3 || true)"
fi

exec_real_python() {
  if [ -z "$real_python" ]; then
    echo "Error: real python binary not found on PATH" >&2
    exit 1
  fi
  exec "$real_python" "$@"
}

for arg in "$@"; do
  case "$arg" in
    -mpip)
      echo "Error: 'python -m pip' is disabled. Use the correct tool:" >&2
      echo "" >&2
      echo "  To add a project dependency:     uv add PACKAGE" >&2
      echo "  To install in the active venv:   uv pip install PACKAGE" >&2
      echo "  To install a CLI tool globally:  pipx install PACKAGE" >&2
      exit 1
      ;;
    -mvenv)
      echo "Error: 'python -m venv' is disabled. Use uv instead:" >&2
      echo "" >&2
      echo "  To create a virtual environment: uv venv" >&2
      exit 1
      ;;
    -mpy_compile)
      echo "Error: 'python -m py_compile' is disabled because it writes .pyc files to __pycache__." >&2
      echo "" >&2
      echo "  To verify syntax without bytecode output: uv run python -m ast path/to/file.py >/dev/null" >&2
      exit 1
      ;;
  esac
done

prev=""
for arg in "$@"; do
  if [ "$prev" = "-m" ]; then
    case "$arg" in
      pip)
        echo "Error: 'python -m pip' is disabled. Use the correct tool:" >&2
        echo "" >&2
        echo "  To add a project dependency:     uv add PACKAGE" >&2
        echo "  To install in the active venv:   uv pip install PACKAGE" >&2
        echo "  To install a CLI tool globally:  pipx install PACKAGE" >&2
        exit 1
        ;;
      venv)
        echo "Error: 'python -m venv' is disabled. Use uv instead:" >&2
        echo "" >&2
        echo "  To create a virtual environment: uv venv" >&2
        exit 1
        ;;
      py_compile)
        echo "Error: 'python -m py_compile' is disabled because it writes .pyc files to __pycache__." >&2
        echo "" >&2
        echo "  To verify syntax without bytecode output: uv run python -m ast path/to/file.py >/dev/null" >&2
        exit 1
        ;;
    esac
  fi
  prev="$arg"
done

exec_real_python "$@"
