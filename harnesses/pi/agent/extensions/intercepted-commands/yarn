#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
real_path="$(printf '%s' "$PATH" | awk -v RS=: -v ORS=: -v dir="$script_dir" '$0 != dir { print }' | sed 's/:$//')"
real_yarn="$(PATH="$real_path" command -v yarn || true)"

if [ -z "$real_yarn" ]; then
  echo "Error: real yarn binary not found on PATH" >&2
  exit 1
fi

exec "$real_yarn" "$@"
