{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "$HOME/.local/bin/dcg",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "node \"$HOME/.claude/hooks/PreToolUse/git-guard.js\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
