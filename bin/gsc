#!/usr/bin/env bash
# Agent-native Google Search Console access.
#
# Replaces the mcp-gsc MCP server, which broke on MCP SDK drift
# (ModuleNotFoundError: mcp.server.fastmcp) and surfaced only as `-32000`.
#
# The implementation, gsc.py, sits next to this wrapper in the harness's
# bin (linked as ~/.claude/bin by ./setup), so it survives a machine
# rebuild. Only the venv is local, and it is disposable; recreate with:
#
#   uv venv ~/.local/share/gsc-cli/venv --python 3.12
#   uv pip install --python ~/.local/share/gsc-cli/venv/bin/python \
#       google-api-python-client google-auth
#
set -euo pipefail

SELF=$(readlink -f -- "${BASH_SOURCE[0]}")
VENV="${HOME}/.local/share/gsc-cli/venv"
IMPL="${SELF%/*}/gsc.py"

if [ ! -x "$VENV/bin/python" ]; then
  echo "gsc: venv missing at $VENV" >&2
  echo "gsc: recreate it with the commands in the header of $0" >&2
  exit 3
fi

exec "$VENV/bin/python" "$IMPL" "$@"
