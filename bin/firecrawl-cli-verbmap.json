{
  "schema_version": 1,
  "vendor_version": "1.26.25",
  "notes": [
    "Hand-maintained from the wrapper registry and vendor_arguments; raw passthrough has no fixed flag contract.",
    "Null means the vendor help states no default; it does not assert an API default.",
    "Scrape and parse --only-main-content name the API default without stating a CLI default.",
    "The injection check is unavailable through vendor CLI 1.26.25, as recorded by the wrapper; there is no exposed flag or stated default to compare.",
    "Agent --max-credits is forwarded when supplied; its API default is not stated in CLI help. Model routing is not a help-text default.",
    "The wrapper keeps the developer category API-direct through the same envelope and budget, requiring FIRECRAWL_API_KEY.",
    "gov and developer are listed vendor commands; the wrapper still answers these verbs API-direct (POST /v2/search/gov and /v2/search/developer)."
  ],
  "command_groups": {
    "": [
      "alexandria",
      "batch-scrape",
      "create-skill",
      "developer",
      "find-skills",
      "find-tools",
      "gov",
      "list",
      "read-skill",
      "status",
      "update-skill",
      "scrape",
      "crawl",
      "map",
      "parse",
      "monitor",
      "search",
      "research",
      "feedback",
      "search-feedback",
      "agent",
      "interact",
      "experimental",
      "config",
      "view-config",
      "login",
      "logout",
      "init",
      "setup",
      "make",
      "launch",
      "env",
      "credit-usage",
      "doctor",
      "version",
      "help"
    ],
    "interact": [
      "stop"
    ]
  },
  "commands": {
    "scrape": {
      "flags": [
        "--format",
        "--only-main-content",
        "--screenshot",
        "--schema",
        "--schema-file",
        "--query",
        "--actions",
        "--actions-file",
        "--max-age",
        "--json"
      ],
      "defaults": {
        "--format": null,
        "--only-main-content": null,
        "--screenshot": "false",
        "--json": "false",
        "--max-age": null
      }
    },
    "parse": {
      "flags": [
        "--format",
        "--only-main-content",
        "--query",
        "--timeout",
        "--json"
      ],
      "defaults": {
        "--format": null,
        "--only-main-content": null,
        "--json": "false"
      }
    },
    "agent": {
      "flags": [
        "--schema",
        "--schema-file",
        "--max-credits",
        "--model",
        "--status",
        "--wait",
        "--cancel",
        "--json"
      ],
      "defaults": {
        "--max-credits": null,
        "--json": "false"
      }
    },
    "interact": {
      "flags": [
        "--code",
        "--prompt",
        "--scrape-id",
        "--node",
        "--python",
        "--bash",
        "--timeout",
        "--json"
      ],
      "defaults": {
        "--scrape-id": "last scrape",
        "--timeout": "30",
        "--json": "false"
      }
    },
    "interact stop": {
      "flags": [
        "--json"
      ],
      "defaults": {
        "--json": "false"
      }
    },
    "search": {
      "flags": [
        "--limit",
        "--categories",
        "--sources",
        "--tbs",
        "--location",
        "--json"
      ],
      "defaults": {
        "--json": "false",
        "--sources": "web; with an API key, alexandria is always added"
      }
    },
    "map": {
      "flags": [
        "--limit",
        "--json"
      ],
      "defaults": {
        "--json": "false"
      }
    },
    "credit-usage": {
      "flags": [
        "--json"
      ],
      "defaults": {
        "--json": "false"
      }
    }
  }
}
