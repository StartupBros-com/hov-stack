{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hov\" hook SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hov\" hook UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hov\" hook PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 -I \"$0\" wake; [ $? -eq 86 ] && exit 2; exit 0' \"${CLAUDE_PLUGIN_ROOT}/scripts/hov\"",
            "asyncRewake": true,
            "rewakeMessage": "hov: mail from other agents reached this idle session.",
            "rewakeSummary": "hov: mail from another agent",
            "timeout": 14400
          }
        ]
      }
    ]
  }
}
