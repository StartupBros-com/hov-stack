#!/bin/sh
# node-hook: run a first-party hook script on the first non-shim `node` on PATH.
#
#   "$HOME/.claude/hooks/bin/node-hook" "$HOME/.claude/hooks/<Event>/<hook>.js" [args...]
#
# Why: a version-manager shim (mise, asdf) is a launcher that resolves the real
# node per call. On a WSL host whose PATH ends in dozens of /mnt/c entries the
# mise shim spends ~100-140 ms walking them before it execs node, on EVERY hook
# of EVERY tool call (`node -e ''`: 199 ms via the shim, 28 ms direct). This
# launcher walks PATH in the shell, takes the first `node` that is not inside a
# shim dir, and execs it. Measured in the 2026-11-03 hook-floor profile (#369).
#
# Contract (hooks/tests/hook-launcher-golden.test.js holds every registered hook
# to it): exec, so stdin, stdout, stderr, exit code, argv, cwd and env reach
# node untouched. No pipe, no wrapper process, nothing written. One exception:
# the pr-record stdin gate below hands node its buffered stdin through a pipe,
# with the shell left as node's parent and node's exit code passed through.
# Variables named `_hn_*` belong to this launcher; an inherited one is reset
# before use, so nothing in the caller's env can steer a hook's stdin.
#
# Bounded: only `[ -f ]` / `[ -x ]` on PATH entries, never a /mnt/* entry (a
# drvfs lookup costs ~2 ms each), never anything outside PATH. When no non-shim
# node is found the last step is the literal command the hook ran before this
# launcher existed, `exec node "$@"`, so a PATH shape this does not understand
# behaves exactly as it did.
#
# Skipped as shims: mise (*/mise/shims) and asdf (*/.asdf/shims, */asdf/shims);
# both resolve per call through a launcher that reads project tool-version
# files, which is the cost being removed. Other `shims` dirs (nodenv, rbenv) are
# not guessed at: they are not measured here.
#
# Env gate (#369, pass 2): hooks/PreToolUse/loop-guard.js is registered with matcher `*`
# (every tool call) and, unless env CLAUDE_LOOP_GUARD is exactly `1`, its run() returns
# its input untouched at its first statement (loop-guard.js: `if (process.env.CLAUDE_LOOP_GUARD
# !== '1') return rawInput;`), the entry point reads stdin to EOF and writeHookOutput()
# prints nothing, exit 0. So the launcher skips the ~30 ms node start for that one script
# when the same predicate is false: it drains stdin (as the JS does) and exits 0.
#   - `[ "$X" = 1 ]` is the shell spelling of `process.env.X !== '1'` negated: both are exact
#     string equality (unset, empty, `0`, `true`, ` 1`, `1 ` and `01` all skip in both).
#   - Only the `case` pattern below costs anything on every other hook: a builtin string
#     match, no process, no syscall.
#   - hooks/tests/hook-launcher-golden.test.js and node-hook.test.js tie the literal here
#     to the JS (drift test) and prove old == new for every env spelling.
# The one thing the skip drops is the seam heartbeat that module load used to write;
# scripts/hook-seam-check.py pairs beats only against tools some other guard covers.
#
# Stdin gate (#369, pass 3): hooks/PostToolUse/pr-record.js is the only seed PostToolUse hook on
# Bash. Its run() parses stdin and returns it untouched (writeHookOutput prints nothing, exit 0,
# empty stderr) unless `tool_input.command` includes the literal `gh pr create`. Nothing with an
# effect runs before that return, and its modules have no load-time effects. So the launcher reads
# stdin and skips node unless the raw bytes COULD decode to a command holding the literal:
#   skip iff stdin contains none of `gh pr create`, `\u002`, `\u006`, `\u007`.
# The last three are the JSON escape spellings of every character of the literal (space U+0020,
# g h p r c e a t U+0061..U+0074): a producer may write any of them as \uXXXX, so soundness does
# not depend on the encoder. Any other escape (\n, \u001b) cannot yield those characters.
# When node is needed it gets the same bytes back: `tr '\0' '\1'` swaps NUL (which dash would
# silently drop; a raw NUL and a raw \001 are both a JSON.parse error, so the outcome is the
# same), and the `x` sentinel keeps the trailing newlines `$(...)` would strip.
# Tied to the JS by hooks/tests/node-hook.test.js (drift test).
# `_hn_stdin` is set only by that arm; clear any inherited value so an exported
# `_hn_stdin` can never pipe `_hn_buf` into another hook in place of its stdin.
_hn_stdin=
case $1 in
  */PreToolUse/loop-guard.js)
    if [ "$CLAUDE_LOOP_GUARD" != 1 ]; then
      command exec cat >/dev/null 2>&1
      exit 0
    fi
    ;;
  */PostToolUse/pr-record.js)
    _hn_buf=$(tr '\0' '\1'; echo x)
    _hn_buf=${_hn_buf%x}
    case $_hn_buf in
      *'gh pr create'* | *'\u002'* | *'\u006'* | *'\u007'*) _hn_stdin=1 ;;
      *) exit 0 ;;
    esac
    ;;
esac
# `set -f`: the unquoted $PATH split below must not glob-expand an entry holding
# `*`, `?` or `[` into other directories, which the shell's own command lookup
# never does. Nothing after it relies on globbing ("$@" is quoted).
set -f
_hn_ifs=$IFS
IFS=:
for _hn_d in $PATH; do
  case $_hn_d in
    '' | /mnt/* | */mise/shims | */mise/shims/ | */.asdf/shims | */.asdf/shims/ | */asdf/shims | */asdf/shims/) continue ;;
  esac
  if [ -f "$_hn_d/node" ] && [ -x "$_hn_d/node" ]; then
    IFS=$_hn_ifs
    [ -z "$_hn_stdin" ] || { printf '%s' "$_hn_buf" | "$_hn_d/node" "$@"; exit $?; }
    exec "$_hn_d/node" "$@"
  fi
done
IFS=$_hn_ifs
[ -z "$_hn_stdin" ] || { printf '%s' "$_hn_buf" | node "$@"; exit $?; }
exec node "$@"
