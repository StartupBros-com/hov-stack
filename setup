#!/usr/bin/env bash
# hov-stack setup: link this checkout into Claude Code's config directory, install dcg, and
# install the default plugins from the hov marketplace.
#
#   ./setup            run every step below
#   ./setup --no-dcg   the same, without downloading or installing dcg
#   ./setup --check    change nothing: print each step's state, exit 1 if any is not in place
#                      (add --no-dcg to leave dcg out of the check)
#   ./setup --update   bring hov-stack and what it installed up to date, then run every step
#                      below. Not with --check (exit 2). In order:
#                        - fast-forwards this checkout with `git fetch` and `git merge --ff-only`
#                          of its upstream, then runs the NEW setup for the rest. It never
#                          stashes, resets or rebases: no git work tree, a detached HEAD, no
#                          upstream, commits of yours the upstream lacks, a fetch that fails, or
#                          local changes the fast-forward would overwrite each leave the checkout
#                          as it is, print one row with the fix, and the rest still runs.
#                        - after the steps below, refreshes the hov marketplace and the
#                          marketplaces of the other publishers' plugins hov-stack offers that
#                          you have added (never the others), and updates the plugins from
#                          those catalogs that hov-stack offers and you have installed. It never
#                          passes -y or --accept-command: if Claude Code refuses an update,
#                          its line is shown and the rest goes on.
#                        - updates gh, uv, cass and jsm with hov-setup's install-release.sh
#                          --update, only where hov-stack installed them and the file is
#                          unchanged since (its record is under ~/.local/state/hov-stack),
#                          and never to an older version; one you installed some other way,
#                          or one that updated itself (jsm, cass upgrade), is left alone.
#                        - runs `uv tool upgrade` for the uv tools hov-stack offers that you
#                          have installed, never installing one you lack; the git-tag offer is
#                          re-installed at its current tag only when uv's own record says it was
#                          installed from that offer's repository at an older tag (a newer tag,
#                          a branch or a commit you chose stays).
#                        - prints the `jsm upgrade` line when jsm is on PATH; it is your paid
#                          account's skills, so setup does not run it.
#                      Claude Code itself, the codex CLI and anything installed some other way
#                      are not touched.
#
# Each step is reported ok, skipped with the command to run later, or failed:
#   1. Symlinks the harness into $CLAUDE_CONFIG_DIR (default ~/.claude):
#      also links the plugin folders listed in the overlay's skill-plugins.
#        CLAUDE.md agents/ bin/ commands/ hooks/ mods/ scripts/ workflows/ claude-env.sh memory-dream.json
#      plus one link per skill in plugins/hov-stack/skills/ and skills-stack/ into
#      skills/, skipping the skills a default plugin provides
#      (lib/default-plugin-skills.txt names them).
#      Anything already at one of those paths is MOVED to ~/.hov-stack-backups/<timestamp>/,
#      never deleted.
#      It also links the data commands in bin/ (lib/manifest.sh's DATA_CLIS: gsc, dfs,
#      stripe-api and ten more) into ~/.local/bin, so they run by name. A free path, or a link
#      to nothing, gets the link; one already resolving to this checkout's file is in place;
#      anything else there, such as a vastai of your own, is left where it is and named, and
#      ours still runs as ~/.claude/bin/<name>. Nothing turns this off: a link you remove is
#      reported missing by --check. setup installs none of their Python packages; gsc, ga4
#      and vastai each say how to add theirs when it is missing.
#   2. Installs dcg, the destructive-command guard, with dcg/install.sh: one pinned release,
#      checked against its checksum and a minisign signature before it lands. Its licence
#      is shown first. A platform with no build, a missing tool or no network is a skip; a
#      refused verification is a failure and installs nothing.
#   3. Seeds settings.json only when none exists. The seed is an allow-list taken from
#      settings.json: permissions, hooks (paths rewritten to this config dir),
#      attribution, cache and compaction settings, and the Claude Code env knobs.
#      Everything bound to my machine (API gateway, login method, pinned model, plugins,
#      status line) is dropped and listed. An existing settings.json is left untouched
#      and the seed is written next to it as settings.hov-stack.json for you to merge,
#      with one exception: a settings.json that holds just the seed setup writes without
#      dcg, plus the plugin keys Claude Code adds to it (in any key order), so one an
#      earlier run seeded and nobody has edited, is moved to ~/.hov-stack-backups/<timestamp>/
#      once dcg is installed and seeded again with dcg's hook, keeping those plugin keys.
#      With dcg installed, a settings.json with no hook that runs dcg is not in place:
#      setup and --check both say so.
#   4. Reads your private overlay: this machine's own files, kept out of the checkout, in
#      $HOV_STACK_OVERLAY, else $XDG_CONFIG_HOME/hov-stack, else ~/.config/hov-stack. Each
#      path must be absolute: a relative XDG_CONFIG_HOME is ignored, as the XDG spec says,
#      and a relative HOV_STACK_OVERLAY is reported and read by nothing. Each file is
#      optional, and setup writes nothing there:
#        settings.json  merged into step 3's seed: its keys win, its lists add to the
#                       template's, a null removes a key, and its hooks get the same dcg
#                       rule. A value of another kind than the template's writes no seed.
#                       It never changes an existing settings.json, only a seed setup writes.
#        CLAUDE.md      imported by rules/hov-stack-overlay.md in the config dir, which
#                       Claude Code loads in every project. A file of anyone else's at that
#                       path is moved to the backup first, like step 1's. A rules/ that is a
#                       symlink into another tree gets nothing written to it.
#        env            NAME=value lines that claude-env.sh exports before each Bash call.
#        skill-plugins  one absolute folder path per line, linked as skills/<name>.
#                       Refuses missing folders or manifests, invalid JSON objects or names,
#                       and names taken by pack/default/retired skills, synced, plugins,
#                       mods or an earlier accepted entry. --check names a missing link,
#                       a shared bare name, a turned-off plugin and one Claude Code does not list.
#   5. With Claude Code 2.1.76 or later on PATH (older releases refuse the hov manifest),
#      adds the hov marketplace and installs the plugins lib/default-plugins.txt names.
#      Then it turns on auto-update for the hov marketplace when settings.json is setup's
#      own unedited seed (step 3's exception), so those plugins get new versions by
#      themselves; for a settings.json you made it only says whether auto-update is on.
#      --check reads what Claude Code reports installed; it writes no record of its own.
#      Then it regenerates rules/hov-stack-tools.md: a line for each installed gh, ast-grep,
#      codex, pro-gate and cass whose program is on PATH, and one naming the data commands
#      PATH runs from this checkout. Only setup's own regular file is
#      replaced or removed; into a rules/ that is a symlink it writes nothing and names the
#      lines to add there, and it leaves a symlink or a file of yours at that path alone.
#   6. Never reads or writes memory, projects/, credentials, or anything outside the config
#      dir, ~/.hov-stack-backups, ~/.local (dcg and the data commands' links in ~/.local/bin;
#      with --update also the install records under ~/.local/state/hov-stack and gh, uv,
#      cass and jsm in ~/.local/bin) and this
#      checkout (its git state, with --update), apart from reading the overlay. No sudo.
#      Only dcg's download and the claude plugin commands use the network; with --update
#      also git fetch, the program downloads of install-release.sh and uv.
#
# Exit status: 0 when every step is in place or was skipped with its fix printed; 1 when
# git or node is missing, dcg's verification refused an artifact, a link or the overlay's
# import could not be made, no seed could be written (an overlay settings.json that is not
# a JSON object, or gives a setting another kind of value than the template's), or --check
# found a step not in place; 2 for an unknown option, or --update with --check. With
# --update a program whose install-release.sh run fails (download, checksum or its own
# --version check) also makes it 1; a refused pull, a program left alone and a command that
# needs the network and could not reach it are rows with their fix, not failures.
# Re-running is a no-op. To undo: remove the symlinks it lists and restore the backup dir.
set -euo pipefail

HOV_STACK=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
CFG=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
# The private overlay (restructure plan U16): the same root the scripts read their private
# maps from (README, "What's not here"). The import written for its CLAUDE.md must be an
# absolute path, since Claude Code reads a relative one against the rules directory.
OVERLAY_XDG=${XDG_CONFIG_HOME:-}
case $OVERLAY_XDG in /*) ;; *) OVERLAY_XDG=$HOME/.config ;; esac
OVERLAY=${HOV_STACK_OVERLAY:-$OVERLAY_XDG/hov-stack}
OVERLAY_RULE=$CFG/rules/hov-stack-overlay.md
OVERLAY_RULE_HEAD='Private additions from the hov-stack overlay, imported by ./setup (edit the file named below, not this one):'
STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP=$HOME/.hov-stack-backups/$STAMP
T0=$(date +%s)
# 2.1.68 to 2.1.75 refuse `marketplace add` on the manifest's metadata and card keys
# (restructure plan gate-2 record); 2.1.76 is the first release that accepts it.
CLAUDE_FLOOR=2.1.76
MARKETPLACE=hov
# The hov marketplace is this repository's root .claude-plugin/ manifest, served from
# GitHub; it arrives with the repository flip (restructure plan U22, U23).
MARKETPLACE_SOURCE=StartupBros-com/hov-stack
DCG_LICENSE=https://github.com/Dicklesworthstone/destructive_command_guard/blob/main/LICENSE

usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; }

check=0
no_dcg=0
update=0
# The arguments as given, so --update can run the new setup with the same ones. The id in
# HOV_STACK_UPDATE_FROM is the checkout --update left; it is read once and removed from the
# environment so nothing setup runs inherits it.
orig_args=("$@")
update_from=${HOV_STACK_UPDATE_FROM:-}
unset HOV_STACK_UPDATE_FROM
for arg in "$@"; do
  case "$arg" in
    -h|--help) usage; exit 0 ;;
    --check) check=1 ;;
    --no-dcg) no_dcg=1 ;;
    --update) update=1 ;;
    *) echo "setup: unknown option $arg (--no-dcg, --check, --update, --help)" >&2; exit 2 ;;
  esac
done
if [ "$update" = 1 ] && [ "$check" = 1 ]; then
  echo "setup: --update changes things and --check changes nothing; use one of them" >&2
  exit 2
fi

missing=()
for c in git node; do command -v "$c" >/dev/null 2>&1 || missing+=("$c"); done
if [ ${#missing[@]} -gt 0 ]; then
  echo "setup: missing required commands: ${missing[*]}" >&2
  echo "  node runs the hooks; git is how you got here. Install them and re-run." >&2
  exit 1
fi

# shellcheck source=lib/link.sh
. "$HOV_STACK/lib/link.sh"
# DATA_CLIS, the data commands step 1 links into ~/.local/bin; the file is data only.
# shellcheck source=lib/manifest.sh
. "$HOV_STACK/lib/manifest.sh"

# The closing status block: one row per step. A row that is not ok counts against --check;
# a failed row makes the run exit 1. "off" is a step the caller turned off with --no-dcg.
rows=()
not_ok=0
failed=0
# Each step's last state (st_<step>), for the plain-language summary under the status block.
st_claude="" st_overlay="" st_links="" st_commands="" st_dcg="" st_settings="" st_marketplace="" st_plugins=""
row_uncounted=0
row() {  # row <step> <state> <detail>
  rows+=("$(printf '  %-12s %-8s %s' "$1" "$2" "$3")")
  printf -v "st_${1//-/_}" '%s' "$2"
  case "$2" in ok|off) ;; *) [ "$row_uncounted" = 1 ] || not_ok=$((not_ok + 1)) ;; esac
  [ "$2" != failed ] || failed=1
}
# An --update row. A skip there is a choice (a program left alone, a pull refused, no network),
# not a step ./setup is waiting to finish, so it stays out of the "steps not finished" count.
urow() { row_uncounted=1; row "$@"; row_uncounted=0; }

# --update, first: fast-forward this checkout, then run the new setup. Nothing has been
# changed yet, so exec-ing into the new file loses nothing; the old process printed no row.
# Every refusal is one row with its fix, and the run goes on with the checkout as it is.
git_in() { git -C "$HOV_STACK" "$@"; }
update_checkout() {
  local top head old new branch up remote out ahead behind first
  top=$(git_in rev-parse --show-toplevel 2>/dev/null) || top=
  if [ -z "$top" ] || [ "$(cd "$top" && pwd -P)" != "$HOV_STACK" ]; then
    urow checkout skipped "$HOV_STACK is not the top of a git checkout, so there is nothing to pull: clone https://github.com/$MARKETPLACE_SOURCE and run ./setup --update from the clone"
    return 0
  fi
  head=$(git_in rev-parse HEAD 2>/dev/null) || head=
  if [ -z "$head" ]; then
    urow checkout skipped "$HOV_STACK has no commits, so there is nothing to pull"
    return 0
  fi
  # The previous run's hand-off: honoured only for a full commit id that is an ancestor of
  # HEAD and not HEAD itself, so a stray variable can never skip the pull.
  old=$update_from
  if [ -n "$old" ] && [ "${#old}" -eq 40 ]; then
    case "$old" in *[!0-9a-f]*) old= ;; esac
  else
    old=
  fi
  if [ -n "$old" ] && [ "$old" != "$head" ] && git_in merge-base --is-ancestor "$old" HEAD >/dev/null 2>&1; then
    echo "hov-stack: ${old:0:7} -> ${head:0:7}"
    urow checkout ok "updated ${old:0:7} -> ${head:0:7}"
    return 0
  fi
  branch=$(git_in symbolic-ref -q --short HEAD 2>/dev/null) || branch=
  if [ -z "$branch" ]; then
    urow checkout skipped "HEAD is detached, so there is no branch to pull: git -C $HOV_STACK switch <your branch>, then re-run ./setup --update"
    return 0
  fi
  up=$(git_in rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) || up=
  if [ -z "$up" ]; then
    urow checkout skipped "$branch has no upstream branch to pull from: git -C $HOV_STACK branch --set-upstream-to=origin/$branch, then re-run ./setup --update"
    return 0
  fi
  remote=$(git_in config --get "branch.$branch.remote" 2>/dev/null) || remote=.
  echo "hov-stack: fetching $up"
  if ! GIT_TERMINAL_PROMPT=0 git_in fetch --quiet "$remote"; then
    urow checkout skipped "could not fetch $remote (offline?): re-run ./setup --update when online"
    return 0
  fi
  if git_in merge-base --is-ancestor '@{u}' HEAD >/dev/null 2>&1; then
    ahead=$(git_in rev-list --count '@{u}..HEAD' 2>/dev/null) || ahead=0
    if [ "$ahead" = 0 ]; then urow checkout ok "up to date at ${head:0:7}"
    else urow checkout ok "up to date at ${head:0:7} ($ahead commits of yours are not on $up; nothing to pull)"
    fi
    return 0
  fi
  if ! git_in merge-base --is-ancestor HEAD '@{u}' >/dev/null 2>&1; then
    ahead=$(git_in rev-list --count '@{u}..HEAD' 2>/dev/null) || ahead="?"
    behind=$(git_in rev-list --count 'HEAD..@{u}' 2>/dev/null) || behind="?"
    urow checkout skipped "$branch has $ahead commits $up lacks and $up has $behind you lack, so it cannot fast-forward; setup never rebases or resets: rebase or merge in $HOV_STACK yourself, then re-run ./setup --update"
    return 0
  fi
  if ! out=$(git_in -c merge.autostash=false merge --ff-only '@{u}' 2>&1); then
    first=$(printf '%s\n' "$out" | grep -m1 '^error:') || first=${out%%$'\n'*}
    urow checkout skipped "git would not fast-forward $branch to $up (${first#error: }): commit or move those changes, then re-run ./setup --update"
    return 0
  fi
  new=$(git_in rev-parse HEAD)
  echo "hov-stack: checkout moved ${head:0:7} -> ${new:0:7}; running the new setup"
  exec env HOV_STACK_UPDATE_FROM="$head" bash "$HOV_STACK/setup" ${orig_args[@]+"${orig_args[@]}"}
}
if [ "$update" = 1 ]; then update_checkout; fi

version_ge() {  # version_ge A B: dotted version A is B or later
  local IFS=. i x y
  local -a a b
  read -r -a a <<<"$1"
  read -r -a b <<<"$2"
  for i in 0 1 2; do
    x=${a[i]:-0} y=${b[i]:-0}
    [ "$x" -gt "$y" ] && return 0
    [ "$x" -lt "$y" ] && return 1
  done
  return 0
}

find_dcg() {  # the dcg the seeded hook will run: the one on PATH, else dcg/install.sh's link
  if command -v dcg >/dev/null 2>&1; then
    command -v dcg
  elif [ -x "$HOME/.local/bin/dcg" ]; then
    echo "$HOME/.local/bin/dcg"
  fi
}

# dcg guards nothing unless a PreToolUse hook runs it (#371). dcg_hooked <settings file>:
# 0 when one does, 1 when none does, 2 when the file does not parse. A command counts when
# dcg is a word of it: the seeded <home>/.local/bin/dcg, a bare dcg, any path ending in
# /dcg. dcg-reap.sh and the like do not.
dcg_hooked() {
  node -e '
    let s;
    try { s = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")); } catch { process.exit(2); }
    const groups = (s && s.hooks && s.hooks.PreToolUse) || [];
    const runs = Array.isArray(groups) && groups.some((g) => g && Array.isArray(g.hooks) &&
      g.hooks.some((h) => h && typeof h.command === "string" && /(^|[\s\/"\x27])dcg($|[\s"\x27;])/.test(h.command)));
    process.exit(runs ? 0 : 1);
  ' "$1"
}
# The fix the settings row names when dcg is installed and settings.json has no hook for it.
dcg_hook_fix() {  # dcg_hook_fix <dcg_hooked status>
  local none="$CFG/settings.json has no PreToolUse hook that runs dcg, so dcg guards nothing"
  if [ "$1" = 2 ]; then echo "$CFG/settings.json does not parse, so no hook in it runs dcg"
  elif untouched_seed "$CFG/settings.json"; then echo "$none: run ./setup, which seeds it again with the hook (it is the unedited seed of a run made before dcg was installed)"
  else echo "$none: copy the entry that runs dcg from $CFG/settings.hov-stack.json, which ./setup writes, into it"
  fi
}

# What Claude Code itself writes into settings.json when setup's plugin step adds the hov
# marketplace and installs the default plugins. It also rewrites the file in its own key
# order. OBSERVED 2026-11-03 on a clean Mac (#371): that was the only difference between the
# first run's settings.json and its seed. The seed never sets these keys.
CLAUDE_WRITES='["enabledPlugins","extraKnownMarketplaces"]'

# untouched_seed <settings.json> [dcg path]: 0 when the file holds the seed this run would write
# with that dcg path (none: dcg absent), plus at most the keys Claude Code writes
# (CLAUDE_WRITES), in any key order. The seed
# is a pure function of the template, the config dir, HOME and the overlay, so a match is a
# settings.json an earlier run seeded and nobody has edited since; any other change, one
# value or one list entry, makes it the user's file.
untouched_seed() {
  local tmp rc=1
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/hov-stack-seed.XXXXXX") || return 1
  if node "$HOV_STACK/lib/settings-seed.js" "$HOV_STACK/settings.json" "$tmp/seed.json" "$CFG" "$HOME" "${2:-}" "$overlay_settings" > /dev/null 2>&1 \
    && node -e '
      const fs = require("fs");
      let live, seed;
      try { live = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); seed = JSON.parse(fs.readFileSync(process.argv[2], "utf8")); } catch { process.exit(1); }
      if (!live || typeof live !== "object" || Array.isArray(live)) process.exit(1);
      for (const k of JSON.parse(process.argv[3])) if (!(k in seed)) delete live[k];
      const same = (a, b) => {
        if (Array.isArray(a) || Array.isArray(b)) return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((x, i) => same(x, b[i]));
        if (a && b && typeof a === "object" && typeof b === "object") {
          const ka = Object.keys(a), kb = Object.keys(b);
          return ka.length === kb.length && ka.every((k) => Object.prototype.hasOwnProperty.call(b, k) && same(a[k], b[k]));
        }
        return a === b;
      };
      process.exit(same(live, seed) ? 0 : 1);
    ' "$1" "$tmp/seed.json" "$CLAUDE_WRITES"; then
    rc=0
  fi
  rm -rf "$tmp"
  return "$rc"
}

# carry_claude_writes <from> <to>: copy the CLAUDE_WRITES keys from the settings.json an
# upgrade moved aside into the one it seeded, so the plugins setup installed stay enabled.
carry_claude_writes() {
  node -e '
    const fs = require("fs");
    const from = JSON.parse(fs.readFileSync(process.argv[1], "utf8")), to = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
    const carried = [];
    for (const k of JSON.parse(process.argv[3])) if (k in from && !(k in to)) { to[k] = from[k]; carried.push(k); }
    fs.writeFileSync(process.argv[2], JSON.stringify(to, null, 2) + "\n");
    if (carried.length) console.log(`  kept what Claude Code had written there: ${carried.join(", ")}`);
  ' "$1" "$2" "$CLAUDE_WRITES"
}

# Every link setup makes: the harness entries, then the skills. A skill a default plugin
# provides is not linked (restructure plan KTD12): the plugin's copy is the one that stays
# current, and two copies under one name list twice. The pack is read from its real path;
# the root `skills` link is a plain file in a checkout made without symlink support. The
# lookup is a string, not an array: macOS ships bash 3.2. The `|| [ -n ]` keeps a last line
# that lost its newline.
# skills-stack/ holds the skills that run this checkout's scripts, which a plugin install
# of the pack does not have (restructure plan R21's exception), so only setup links them.
srcs=()
dsts=()
for name in CLAUDE.md agents bin commands hooks mods scripts workflows claude-env.sh memory-dream.json; do
  srcs+=("$HOV_STACK/$name")
  dsts+=("$CFG/$name")
done
provided=" "
while read -r name plugin _ || [ -n "$name" ]; do
  case "$name" in ''|'#'*) continue ;; esac
  provided="$provided$name=$plugin "
done < "$HOV_STACK/lib/default-plugin-skills.txt"
skip_lines=()
for skill in "$HOV_STACK"/plugins/hov-stack/skills/*/ "$HOV_STACK"/skills-stack/*/; do
  [ -d "$skill" ] || continue  # an unmatched glob stays literal
  skill=${skill%/}
  name=$(basename "$skill")
  case "$provided" in
    *" $name="*)
      plugin=${provided#*" $name="}
      skip_lines+=("  skipped $name: the ${plugin%% *} plugin provides it")
      continue ;;
  esac
  srcs+=("$skill")
  dsts+=("$CFG/skills/$name")
done

defaults=()
while read -r name _ || [ -n "$name" ]; do
  case "$name" in ''|'#'*) continue ;; esac
  defaults+=("$name")
done < "$HOV_STACK/lib/default-plugins.txt"

# The claude CLI and its version, read once: the marketplace and plugin steps need it at
# or above the floor. A version that does not parse is tried anyway and reported unknown.
claude_state=missing
claude_version=
if command -v claude >/dev/null 2>&1; then
  claude_out=$(claude --version) || claude_out=
  claude_version=${claude_out%% *}
  case "$claude_version" in
    ''|*[!0-9.]*) claude_state=unknown ;;
    *) if version_ge "$claude_version" "$CLAUDE_FLOOR"; then claude_state=ok; else claude_state=old; fi ;;
  esac
fi
claude_row() {
  case "$claude_state" in
    ok) row claude ok "$claude_version (needs $CLAUDE_FLOOR or later)" ;;
    missing) row claude missing "not on PATH: install Claude Code $CLAUDE_FLOOR or later, then re-run ./setup" ;;
    old) row claude old "$claude_version is below the $CLAUDE_FLOOR floor, under which the CLI refuses the $MARKETPLACE manifest: run 'claude update', then re-run ./setup" ;;
    *) row claude unknown "could not read a version from 'claude --version'; the plugin steps need $CLAUDE_FLOOR or later" ;;
  esac
}
claude_usable() { [ "$claude_state" = ok ] || [ "$claude_state" = unknown ]; }

# The claude plugin commands' JSON, read with node (setup already requires it).
# marketplace_listed returns 3 when hov is not added; installed_plugins prints
# "<plugin> <version>" for each user-scope plugin from hov (a project-scope install
# elsewhere does not count). Any other non-zero return: unreadable.
JS_MARKETPLACE='
const rows = JSON.parse(require("fs").readFileSync(0, "utf8"));
if (!rows.some((r) => r.name === process.argv[1])) process.exit(3);'
JS_PLUGINS='
const rows = JSON.parse(require("fs").readFileSync(0, "utf8"));
const suffix = "@" + process.argv[1];
for (const r of rows)
  if (r.scope === "user" && r.id.endsWith(suffix)) console.log(r.id.slice(0, -suffix.length), r.version || "unknown");'
marketplace_listed() {
  local json
  json=$(claude plugin marketplace list --json) || return 1
  printf '%s' "$json" | node -e "$JS_MARKETPLACE" "$MARKETPLACE" || return $?
}
installed_plugins() {
  local json
  json=$(claude plugin list --json) || return 1
  printf '%s' "$json" | node -e "$JS_PLUGINS" "$MARKETPLACE" || return $?
}
version_of() { printf '%s\n' "$2" | awk -v p="$1" '$1 == p { print $2; exit }'; }  # <plugin> <list>

# --update, after the steps below. What to refresh and update, from the same two commands
# the steps read (`claude plugin marketplace list --json`, `claude plugin list --json`) and
# offers.json: "M <marketplace>" for hov and for each other-plugin offer whose marketplace
# Claude Code lists as added (found by its GitHub repository, the way detect.mjs does, not by
# the name the user gave it), and "P <id>" for each user-scope plugin hov-stack offers (the
# hov offers, the default plugins, the other-plugin offers) that is installed. Nothing else:
# not the user's other marketplaces, not their other plugins.
OFFERS_JSON=$HOV_STACK/plugins/hov-stack/skills/hov-setup/scripts/offers.json
SETUP_DETECT=$HOV_STACK/plugins/hov-stack/skills/hov-setup/scripts/detect.mjs
INSTALL_RELEASE=$HOV_STACK/plugins/hov-stack/skills/hov-setup/scripts/install-release.sh
JS_UPDATE_PLAN='
const fs = require("fs");
const [offersPath, mjson, pjson, hov, defs] = process.argv.slice(1);
const offers = JSON.parse(fs.readFileSync(offersPath, "utf8")).offers;
const markets = JSON.parse(mjson).filter((m) => m && typeof m.name === "string");
const user = new Set(JSON.parse(pjson).filter((r) => r && r.scope === "user").map((r) => r.id));
const same = (m, github) => {
  const want = github.toLowerCase();
  if (typeof m.repo === "string" && m.repo.toLowerCase() === want) return true;
  if (typeof m.url !== "string") return false;
  return m.url.toLowerCase().replace(/\/+$/, "").replace(/\.git$/, "").replace(/\/+$/, "") === "https://github.com/" + want;
};
const ms = [], ps = [];
const add = (a, x) => { if (!a.includes(x)) a.push(x); };
if (markets.some((m) => m.name === hov)) {
  add(ms, hov);
  const names = offers.filter((o) => o.kind === "plugin").map((o) => o.name).concat(defs.split(" ").filter(Boolean));
  for (const n of names) if (user.has(n + "@" + hov)) add(ps, n + "@" + hov);
}
for (const o of offers) {
  if (o.kind !== "other-plugin") continue;
  const named = markets.filter((m) => same(m, o.marketplace.github)).map((m) => m.name);
  if (!named.length) continue;
  const hit = named.find((n) => user.has(o.plugin + "@" + n));
  add(ms, hit || named[0]);
  if (hit) add(ps, o.plugin + "@" + hit);
}
for (const m of ms) console.log("M " + m);
for (const p of ps) console.log("P " + p);'
# The uv tools hov-stack offers: offers.json tools whose install line for this platform is
# `<uv> tool install ...`. One tab-separated line each: tool name (the last word, or for a git
# offer the repository's name), git repository URL or -, tag or -, the line after `<uv> `.
JS_UV_OFFERS='
import fs from "node:fs";
import { pathToFileURL } from "node:url";
const { platformName } = await import(pathToFileURL(process.argv[2]).href);
const platform = platformName();
const head = "<uv> tool install ";
for (const o of JSON.parse(fs.readFileSync(process.argv[1], "utf8")).offers) {
  const line = o.install && o.install[platform];
  if (o.kind !== "tool" || typeof line !== "string" || !line.startsWith(head)) continue;
  const rest = line.slice("<uv> ".length);
  const g = /git\+(https:\/\/\S+?)@(\S+)$/.exec(line);
  if (g) console.log([g[1].split("/").pop(), g[1], g[2], rest].join("\t"));
  else console.log([line.split(" ").pop(), "-", "-", rest].join("\t"));
}'
# What uv recorded for an installed tool (uv-receipt.toml), against the offer's repository and
# tag: current (at the tag), older-tag (an x.y.z tag older than it), other-rev (any other
# revision: a newer tag, a branch, a commit, or none) or other-source. uv writes the revision
# into the git URL's query, as in git = "https://github.com/o/r?rev=v0.1.0"; a separate
# rev or tag field is read too.
JS_UV_RECEIPT='
let text = "";
try { text = require("fs").readFileSync(process.argv[1], "utf8"); } catch { console.log("other-source"); process.exit(0); }
const norm = (u) => u.toLowerCase().replace(/^git\+/, "").replace(/\/+$/, "").replace(/\.git$/, "");
const g = /git\s*=\s*"([^"]+)"/.exec(text);
if (!g) { console.log("other-source"); process.exit(0); }
const [base, query = ""] = g[1].split("#")[0].split("?");
if (norm(base) !== norm(process.argv[2])) { console.log("other-source"); process.exit(0); }
const q = new URLSearchParams(query);
let ref = q.get("rev") || q.get("tag") || q.get("branch") || "";
if (!ref) { const r = /(?:rev|tag)\s*=\s*"([^"]+)"/.exec(text); if (r) ref = r[1]; }
const want = process.argv[3];
if (ref === want) { console.log("current"); process.exit(0); }
const ver = (s) => { const m = /^v?(\d+)\.(\d+)\.(\d+)$/.exec(s); return m ? m.slice(1).map(Number) : null; };
const a = ver(ref), b = ver(want);
console.log(a && b && (a[0] - b[0] || a[1] - b[1] || a[2] - b[2]) < 0 ? "older-tag" : "other-rev");'

update_plugins() {  # marketplaces and plugins; needs the hov marketplace listed
  local mjson pjson plan line name id m_ok=0 m_fail=0 p_ok=0 p_fail=0 out marks="" plugs="" detail
  echo "hov-stack: refreshing the marketplaces hov-stack offers plugins from"
  if ! mjson=$(claude plugin marketplace list --json) || ! pjson=$(claude plugin list --json); then
    urow refresh skipped "could not read what Claude Code lists: re-run ./setup --update"
    return 0
  fi
  if ! plan=$(node -e "$JS_UPDATE_PLAN" "$OFFERS_JSON" "$mjson" "$pjson" "$MARKETPLACE" "${defaults[*]}"); then
    urow refresh failed "could not work out which marketplaces and plugins to update from $OFFERS_JSON"
    return 0
  fi
  while IFS= read -r line; do
    case "$line" in
      'M '*) marks="$marks ${line#M }" ;;
      'P '*) plugs="$plugs ${line#P }" ;;
    esac
  done <<EOF
$plan
EOF
  # Only these names: the bare `claude plugin marketplace update` would refresh every
  # marketplace the user has. No -y and no --accept-command: they would approve, for the user,
  # a command a marketplace declares; a refusal is shown and the run goes on.
  for name in $marks; do
    if out=$(claude plugin marketplace update "$name" 2>&1 < /dev/null); then m_ok=$((m_ok + 1)); else m_fail=$((m_fail + 1)); fi
    [ -z "$out" ] || printf '%s\n' "$out" | sed 's/^/  /'
  done
  [ -z "$plugs" ] || echo "hov-stack: updating the plugins hov-stack offers that you have installed"
  for id in $plugs; do
    if out=$(claude plugin update "$id" --scope user 2>&1 < /dev/null); then p_ok=$((p_ok + 1)); else p_fail=$((p_fail + 1)); fi
    [ -z "$out" ] || printf '%s\n' "$out" | sed 's/^/  /'
  done
  detail="refreshed $m_ok marketplaces, updated $p_ok plugins"
  if [ $((m_fail + p_fail)) -gt 0 ]; then
    urow refresh skipped "$detail; $m_fail marketplace and $p_fail plugin commands did not finish (their lines are above; offline? re-run ./setup --update)"
  else
    urow refresh ok "$detail"
  fi
  if [ "$p_ok" -gt 0 ]; then echo "hov-stack: Claude Code sessions started from now on load the new plugin versions."; fi
}

update_programs() {  # gh, uv, cass, jsm through install-release.sh --update
  local t rc out first
  echo "hov-stack: updating gh, uv, cass and jsm where hov-stack installed them"
  for t in gh uv cass jsm; do
    rc=0
    out=$(bash "$INSTALL_RELEASE" "$t" --update 2>&1 < /dev/null) || rc=$?
    first=${out%%$'\n'*}
    [ -z "$out" ] || printf '%s\n' "$out" | sed 's/^/  /'
    case "$rc" in
      0) urow "$t" ok "$first" ;;
      3|5) urow "$t" skipped "$first" ;;
      *) urow "$t" failed "install-release.sh $t --update exited $rc: $first" ;;
    esac
  done
}

find_uv() {  # the uv the detector would find: PATH, then the usual install directories
  local d
  if command -v uv >/dev/null 2>&1; then command -v uv; return 0; fi
  for d in "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin; do
    if [ -f "$d/uv" ] && [ -x "$d/uv" ]; then echo "$d/uv"; return 0; fi
  done
}

update_uv_tools() {  # uv tool upgrade for the uv tools hov-stack offers that are installed
  local uv listed offered tdir name repo tag args state out notes="" fails=0 seen=0 inst
  uv=$(find_uv)
  if [ -z "$uv" ]; then
    urow uvtools skipped "uv is not installed here, so there are no uv tools to update"
    return 0
  fi
  echo "hov-stack: upgrading the uv tools hov-stack offers that you have installed"
  listed=$("$uv" tool list 2>/dev/null < /dev/null) || listed=
  tdir=$("$uv" tool dir 2>/dev/null < /dev/null) || tdir=
  if ! offered=$(node --input-type=module -e "$JS_UV_OFFERS" "$OFFERS_JSON" "$SETUP_DETECT"); then
    urow uvtools failed "could not read the uv tools offered in $OFFERS_JSON"
    return 0
  fi
  while IFS=$'\t' read -r name repo tag args; do
    [ -n "$name" ] || continue
    printf '%s\n' "$listed" | awk -v n="$name" '$1 == n { f = 1 } END { exit !f }' || continue
    seen=$((seen + 1))
    # Keeps the tool's own source and any pin the user set; moves an unpinned PyPI tool on.
    if out=$("$uv" tool upgrade "$name" 2>&1 < /dev/null); then notes="$notes; $name upgraded"; else fails=$((fails + 1)); notes="$notes; $name not upgraded (see above)"; fi
    [ -z "$out" ] || printf '%s\n' "$out" | sed "s/^/  $name: /"
    [ "$repo" != - ] || continue
    # A git-tag offer follows its tag only when uv's record says the tool came from the
    # offer's repository at an older tag: the offer's own line over another source silently
    # switches it, and over a newer tag, a branch or a commit undoes the user's choice.
    state=$(node -e "$JS_UV_RECEIPT" "$tdir/$name/uv-receipt.toml" "$repo" "$tag")
    case "$state" in
      current) notes="$notes; $name is at $tag" ;;
      other-rev)
        echo "  $name: uv's record says it was installed from $repo at a revision other than an older tag, so it stays there"
        notes="$notes; $name left at the revision you chose"
        ;;
      older-tag)
        echo "hov-stack: $name was installed from $repo at an older tag; installing $tag"
        inst=()
        read -r -a inst <<<"$args"
        if out=$("$uv" "${inst[@]}" 2>&1 < /dev/null); then notes="$notes; $name moved to $tag"; else fails=$((fails + 1)); notes="$notes; $name not moved to $tag (see above)"; fi
        [ -z "$out" ] || printf '%s\n' "$out" | sed "s/^/  $name: /"
        ;;
      *)
        echo "  $name: uv's record says it was installed from somewhere other than $repo, so it stays on that source"
        notes="$notes; $name left on the source you installed it from"
        ;;
    esac
  done <<EOF
$offered
EOF
  if [ "$seen" -eq 0 ]; then
    urow uvtools ok "none of the uv tools hov-stack offers is installed; nothing to upgrade"
  elif [ "$fails" -gt 0 ]; then
    urow uvtools skipped "${notes#; } (offline? re-run ./setup --update)"
  else
    urow uvtools ok "${notes#; }"
  fi
}

# Claude's tool instructions: rules/hov-stack-tools.md holds a line for each installed tool
# that has one in plugins/hov-stack/skills/hov-setup/instructions/, plus one naming the data
# commands PATH runs from this checkout, so Claude is never told to
# use a tool this user lacks. instructions.mjs writes it (it reads the installed plugins through
# claude) and prints "<state>: <reason>"; the state is the row's. Each refusal names its fix.
instructions_row() {  # instructions_row [--check]
  local out rc=0 state
  if ! claude_usable; then
    row instructions skipped "needs Claude Code $CLAUDE_FLOOR or later on PATH, to read the installed plugins"
    return 0
  fi
  out=$(node "$HOV_STACK/plugins/hov-stack/skills/hov-setup/scripts/instructions.mjs" --config-dir "$CFG" "$@" 2>&1) || rc=$?
  out=${out//$'\n'/ }
  state=${out%%: *}
  case "$rc:$state" in
    0:ok | 3:missing | 3:stale | 1:blocked) out=${out#*: } ;;
    *) state=blocked ;;
  esac
  row instructions "$state" "$out"
}

# The overlay's CLAUDE.md is imported by a two-line file setup writes, not by a link to it:
# the header tells whoever opens it which file to edit, and Claude Code documents @ imports
# in a rules file, not a rules file that is a symlink. An import whose file is gone is
# skipped without a word (probed on Claude Code 2.1.310), so the additions would vanish
# quietly: --check names a dangling import, and a rerun takes it away. Nothing is written
# through a rules/ that is a symlink: it leads into another tree, often one that is shared,
# and the import names a path in this HOME.
overlay_usable() { case $OVERLAY in /*) return 0 ;; *) return 1 ;; esac; }

# Own plugin folders stay outside the pack's link count (#476).
skill_plugins_row() {
  local mode=$1 state=ok detail="" names="" taken=" " count=0 folder name why dst inner s target
  local reserved=" " item label list line cli_json="" cli_ok=0
  overlay_usable || { row skill-plugins ok "nothing listed in $(_lf_display "$OVERLAY")/skill-plugins"; return; }
  for item in "$HOV_STACK"/plugins/hov-stack/skills/*/ "$HOV_STACK"/skills-stack/*/; do
    [ -d "$item" ] || continue
    reserved="$reserved$(basename "$item")=skill-pack "
  done
  for list in "$HOV_STACK/lib/default-plugin-skills.txt" "$HOV_STACK/retired-skills.txt" "$OVERLAY/retired-skills.txt"; do
    [ -f "$list" ] || continue
    label=retired-skills.txt
    if [ "$list" = "$HOV_STACK/lib/default-plugin-skills.txt" ]; then label=lib/default-plugin-skills.txt
    elif [ "$list" = "$OVERLAY/retired-skills.txt" ]; then label=overlay/retired-skills.txt
    fi
    while IFS= read -r line || [ -n "$line" ]; do
      line=${line%%#*}; name=; read -r name item <<< "$line"
      [ -z "$name" ] || reserved="$reserved$name=$label "
    done < "$list"
  done
  reserved="${reserved}synced=synced "
  while IFS='|' read -r name label; do
    [ -z "$name" ] || reserved="$reserved$name=$label "
  done < <(node - "$HOV_STACK" <<'JS'
const fs = require('fs'), root = process.argv[2];
try { for (const p of JSON.parse(fs.readFileSync(root+'/.claude-plugin/marketplace.json')).plugins || []) console.log(p.name+'|marketplace'); } catch {}
for (const d of fs.readdirSync(root+'/mods')) {
  try { console.log(JSON.parse(fs.readFileSync(root+'/mods/'+d+'/.claude-plugin/plugin.json')).name+'|mods'); } catch {}
}
JS
  )
  if [ "$mode" = check ] && claude_usable; then
    cli_json=$(claude plugin list --json) || cli_json=
    if printf '%s' "$cli_json" | node -e 'const x=JSON.parse(require("fs").readFileSync(0,"utf8")); if (!Array.isArray(x)) process.exit(1)' 2>/dev/null; then cli_ok=1; fi
  fi
  if [ -f "$OVERLAY/skill-plugins" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      folder=${line%%#*}
      folder="${folder#"${folder%%[![:space:]]*}"}"
      folder="${folder%"${folder##*[![:space:]]}"}"
      [ -n "$folder" ] || continue
      why="" name=""
      case $folder in /*) ;; *) why='not an absolute path' ;; esac
      if [ -z "$why" ]; then
        if [ ! -d "$folder" ]; then why='no folder there'
        elif [ ! -f "$folder/.claude-plugin/plugin.json" ]; then why='no .claude-plugin/plugin.json'
        elif ! name=$(node -e 'const fs=require("fs"); try {const p=JSON.parse(fs.readFileSync(process.argv[1])); if (!p || Array.isArray(p) || typeof p!=="object" || typeof p.name!=="string" || !/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(p.name)) throw Error(); console.log(p.name)} catch {process.exit(1)}' "$folder/.claude-plugin/plugin.json"); then why='plugin.json must be a JSON object with a valid name'
        fi
      fi
      if [ -z "$why" ]; then
        # Space-delimited lookups keep setup compatible with bash 3.2.
        for item in $reserved; do
          if [ "${item%%=*}" = "$name" ]; then why="name $name clashes with ${item#*=}"; break; fi
        done
        case $taken in *" $name "*) why="name $name clashes with an earlier accepted entry" ;; esac
      fi
      if [ -n "$why" ]; then
        state=invalid; [ "$mode" = check ] || state=failed
        detail="$detail$(_lf_display "$folder"): $why; "
        [ "$mode" = check ] || echo "  skill-plugins: refused $(_lf_display "$folder"): $why"
        continue
      fi
      taken="$taken$name "; count=$((count + 1)); names="$names$name, "
      dst=$CFG/skills/$name
      if [ "$mode" != check ]; then
        if ! link_file "$folder" "$dst" "$BACKUP"; then
          state=failed; detail="${detail}skills/$name could not be linked to $(_lf_display "$folder"); "
        fi
        continue
      fi
      if [ -L "$dst" ]; then
        if [ ! "$dst" -ef "$folder" ]; then
          target=$(readlink "$dst")
          detail="${detail}skills/$name points at $(_lf_display "$target"), not $(_lf_display "$folder"): run ./setup; "
        fi
      elif [ -e "$dst" ]; then
        detail="${detail}skills/$name is not the link to $(_lf_display "$folder"): run ./setup, which moves it to the backup first; "
      else detail="${detail}skills/$name is not linked: run ./setup; "
      fi
      for inner in "$folder"/skills/*/SKILL.md; do
        [ -f "$inner" ] || continue
        s=$(basename "$(dirname "$inner")")
        [ "$s" != "$name" ] || continue  # skills/<name> is this plugin's own link, checked above
        if [ -e "$CFG/skills/$s" ] || [ -L "$CFG/skills/$s" ]; then
          detail="${detail}skills/$s shares the bare name /$s with $name's skill (which one /$s runs is not established): remove or rename one; "
        fi
      done
      if node -e 'try {const p=JSON.parse(require("fs").readFileSync(process.argv[1])); process.exit(p.enabledPlugins?.[process.argv[2]]===false?0:1)} catch {process.exit(1)}' "$CFG/settings.json" "$name@skills-dir"; then
        detail="${detail}$name@skills-dir is turned off in settings.json: run claude plugin enable $name@skills-dir; "
      fi
      if [ "$cli_ok" = 1 ] && ! printf '%s' "$cli_json" | node -e 'const x=JSON.parse(require("fs").readFileSync(0,"utf8")); process.exit(x.some(p=>p.id===process.argv[1])?0:1)' "$name@skills-dir"; then
        detail="${detail}Claude Code does not list $name@skills-dir (a managed setting such as strictKnownMarketplaces can leave skills-dir plugins out without a message); "
      fi
    done < "$OVERLAY/skill-plugins"
  fi
  if [ -n "$detail" ]; then
    [ "$state" != ok ] || state=missing
    row skill-plugins "$state" "${detail%; }"
  elif [ "$count" -eq 0 ]; then row skill-plugins ok "nothing listed in $(_lf_display "$OVERLAY")/skill-plugins"
  else row skill-plugins ok "$count linked from $(_lf_display "$OVERLAY")/skill-plugins: ${names%, }"
  fi
}
overlay_rule_target() {  # the path setup's own rules file imports; fails when the file is not setup's
  [ -f "$OVERLAY_RULE" ] && [ ! -L "$OVERLAY_RULE" ] || return 1
  awk -v h="$OVERLAY_RULE_HEAD" '
    NR == 1 { mine = ($0 == h) } NR == 2 { t = $0 }
    END { if (!mine || NR != 2 || substr(t, 1, 1) != "@") exit 1; print substr(t, 2) }' "$OVERLAY_RULE"
}
overlay_import() {  # write setup's rules file for $OVERLAY/CLAUDE.md, or take it away; 1 when it could not
  local target rel
  overlay_usable && [ ! -L "$CFG/rules" ] || return 0
  target=$(overlay_rule_target) || target=
  if [ ! -f "$OVERLAY/CLAUDE.md" ]; then
    [ -n "$target" ] || return 0
    rm -f "$OVERLAY_RULE" || return 1
    echo "  removed $(_lf_display "$OVERLAY_RULE"): it imported $target, and there is no $OVERLAY/CLAUDE.md"
    return 0
  fi
  [ "$target" != "$OVERLAY/CLAUDE.md" ] || return 0
  if [ -z "$target" ] && { [ -e "$OVERLAY_RULE" ] || [ -L "$OVERLAY_RULE" ]; }; then
    rel=${OVERLAY_RULE#"$HOME"/}
    [ "$rel" != "$OVERLAY_RULE" ] || rel=$(basename "$OVERLAY_RULE")
    mkdir -p "$BACKUP/$(dirname "$rel")" || return 1
    mv "$OVERLAY_RULE" "$BACKUP/$rel" || return 1
    echo "  backed up $(_lf_display "$OVERLAY_RULE") -> $BACKUP/$rel"
  fi
  mkdir -p "$CFG/rules" || return 1
  printf '%s\n@%s\n' "$OVERLAY_RULE_HEAD" "$OVERLAY/CLAUDE.md" > "$OVERLAY_RULE" || return 1
  echo "  $(_lf_display "$OVERLAY_RULE") imports $OVERLAY/CLAUDE.md"
}
JS_OBJECT='
let v;
try { v = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")); }
catch (err) { console.log(err.message); process.exit(1); }
if (v === null || typeof v !== "object" || Array.isArray(v)) { console.log("not an object"); process.exit(1); }'
# One overlay row for --check and the run alike. A rules file out of step with the overlay is
# a fix to run in --check; in a run it is a failure, because the import step could not write.
overlay_problem() {  # overlay_problem <state> <text>: the first names overlay_row's state; a failure wins
  problems+=("$2")
  if [ "$state" = ok ] || [ "$1" = failed ]; then state=$1; fi
}
overlay_row() {  # overlay_row check|run
  local mode=$1 state=ok target want why detail unimported=missing stale=stale
  local -a parts=() problems=()
  if ! overlay_usable; then
    row overlay invalid "HOV_STACK_OVERLAY is $OVERLAY, not an absolute path, so ./setup reads nothing there and claude-env.sh reads no env from it"
    return 0
  fi
  if [ "$mode" = run ]; then unimported=failed stale=failed; fi
  if [ -f "$OVERLAY/settings.json" ]; then
    if ! why=$(node -e "$JS_OBJECT" "$OVERLAY/settings.json"); then
      overlay_problem invalid "$OVERLAY/settings.json is not a JSON object ($why), so ./setup writes no seed"
    elif [ "$mode" = check ]; then
      # The merge itself, into /dev/null: the one way to see an overlay the run would refuse.
      if why=$(node "$HOV_STACK/lib/settings-seed.js" "$HOV_STACK/settings.json" /dev/null "$CFG" "$HOME" "" "$OVERLAY/settings.json" 2>&1 >/dev/null); then
        parts+=("settings.json merged only into a seed ./setup writes, never an existing settings.json")
      else
        why=${why%%$'\n'*}
        why=${why#settings-seed: }
        overlay_problem invalid "${why%; no seed was written}, so ./setup writes no seed"
      fi
    elif [ "$seed_ok" = 1 ]; then parts+=("settings.json merged into the seed at $seed_target")
    else overlay_problem failed "$OVERLAY/settings.json was not merged: lib/settings-seed.js wrote no seed (see above)"
    fi
  fi
  target=$(overlay_rule_target) || target=
  want=
  if [ -f "$OVERLAY/CLAUDE.md" ]; then want=$OVERLAY/CLAUDE.md; fi
  if [ -n "$want" ] && [ "$target" = "$want" ]; then
    parts+=("CLAUDE.md imported by rules/hov-stack-overlay.md")
  elif [ -L "$CFG/rules" ]; then
    if [ -n "$want" ] && [ -d "$CFG/rules/" ] && grep -rqxF "@$want" "$CFG/rules/"; then
      parts+=("CLAUDE.md imported by a rules file under rules/, a symlink")
    elif [ -n "$want" ]; then
      overlay_problem missing "rules/ is a symlink, so ./setup writes no import into it: add the line @$want to a rules file there"
    elif [ -n "$target" ]; then
      overlay_problem missing "rules/ is a symlink, so ./setup leaves rules/hov-stack-overlay.md, which imports $target, for you to remove"
    fi
  elif [ -n "$want" ]; then
    if [ -n "$target" ]; then overlay_problem "$stale" "rules/hov-stack-overlay.md imports $target, not $want: run ./setup"
    else overlay_problem "$unimported" "$want is not imported by rules/hov-stack-overlay.md: run ./setup"
    fi
  elif [ -n "$target" ]; then
    if [ -f "$target" ]; then overlay_problem "$stale" "rules/hov-stack-overlay.md imports $target, but there is no $OVERLAY/CLAUDE.md: run ./setup"
    else overlay_problem "$stale" "rules/hov-stack-overlay.md imports $target, which is gone: run ./setup"
    fi
  fi
  if [ -f "$OVERLAY/env" ]; then
    if why=$(bash -n "$OVERLAY/env" 2>&1); then parts+=("env read before each Bash call")
    else overlay_problem invalid "$OVERLAY/env does not parse under bash (${why%%$'\n'*}); claude-env.sh sources it before every Bash call"
    fi
  fi
  if [ ${#problems[@]} -gt 0 ]; then
    detail=$(printf '%s; ' "${problems[@]}")
    row overlay "$state" "${detail%; }"
  elif [ ${#parts[@]} -gt 0 ]; then
    detail=$(printf '%s; ' "${parts[@]}")
    row overlay ok "$OVERLAY: ${detail%; }"
  else
    row overlay ok "nothing at $OVERLAY (settings.json, CLAUDE.md and env there are optional)"
  fi
}
seed_ok=0
au_on=0
plugins_ready=0  # the hov marketplace is added and its plugins were read (--update refreshes only then)
# The overlay's settings.json the seed merges, read by the seed and by untouched_seed alike.
overlay_settings=
if overlay_usable && [ -f "$OVERLAY/settings.json" ]; then overlay_settings=$OVERLAY/settings.json; fi
dcg_path=

# The data commands (DATA_CLIS) go into ~/.local/bin, so a terminal, a cron job or a systemd
# unit runs them by name, not only a Claude Code session. Not link_file: that moves whatever
# is at the path into the backup, and a vastai or gsc of the user's own must keep working
# where it is. A free path, or a link to nothing, gets the link; one that already resolves to
# this checkout's file is in place; anything else is left alone and named, and ours still
# runs as $CFG/bin/<name>. Only a link that could not be made fails the row. --check makes
# nothing and reports each free path missing.
CLI_DIR=$HOME/.local/bin
commands_row() {  # commands_row run|check
  local mode=$1 name src dst old have=0 kept="" absent="" broken="" detail
  if [ "$mode" = run ] && ! mkdir -p "$CLI_DIR"; then
    row commands failed "could not make $(_lf_display "$CLI_DIR"), so no data command was linked; each still runs as $(_lf_display "$CFG")/bin/<name>"
    return 0
  fi
  for name in "${DATA_CLIS[@]}"; do
    src=$HOV_STACK/bin/$name
    dst=$CLI_DIR/$name
    if [ -e "$dst" ] && [ "$dst" -ef "$src" ]; then
      have=$((have + 1))
    elif [ -e "$dst" ]; then
      kept="$kept, $name"
    elif [ "$mode" = check ]; then
      absent="$absent $name"
    elif [ -L "$dst" ]; then
      # A link to nothing runs nothing: it is replaced, and what it pointed at is shown.
      old=$(readlink "$dst") || old="?"
      if ln -sfn "$src" "$dst"; then
        have=$((have + 1))
        echo "  $(_lf_display "$dst") pointed at $old, which is gone; it now runs hov-stack's"
      else
        broken="$broken $name"
      fi
    elif ln -s "$src" "$dst"; then
      have=$((have + 1))
    else
      broken="$broken $name"
    fi
  done
  if [ "$have" -eq "${#DATA_CLIS[@]}" ]; then
    detail="${#DATA_CLIS[@]} data commands linked into $(_lf_display "$CLI_DIR")"
  else
    detail="$have of ${#DATA_CLIS[@]} data commands linked into $(_lf_display "$CLI_DIR")"
  fi
  [ -z "$absent" ] || detail="$detail; not linked:$absent; run ./setup"
  [ -z "$broken" ] || detail="$detail; could not link:$broken (see above)"
  [ -z "$kept" ] || detail="$detail; left alone, not hov-stack's: ${kept#, } (ours runs as $(_lf_display "$CFG")/bin/<name>)"
  case ":$PATH:" in
    *":$CLI_DIR:"*) ;;
    *) detail="$detail; $(_lf_display "$CLI_DIR") is not on this shell's PATH: a new login shell may add it, else add it yourself" ;;
  esac
  if [ -n "$broken" ]; then row commands failed "$detail"
  elif [ -n "$absent" ]; then row commands missing "$detail"
  else row commands ok "$detail"
  fi
}

if [ "$check" = 1 ]; then
  echo "hov-stack: checking $HOV_STACK against $CFG (nothing is changed)"
  absent="" i=0
  while [ "$i" -lt "${#srcs[@]}" ]; do
    if [ ! -L "${dsts[i]}" ] || [ ! "${dsts[i]}" -ef "${srcs[i]}" ]; then absent="$absent ${dsts[i]#"$CFG"/}"; fi
    i=$((i + 1))
  done
  if [ -z "$absent" ]; then row links ok "${#srcs[@]} links in place"; else row links missing "not linked:$absent; run ./setup"; fi
  commands_row check

  if [ "$no_dcg" = 1 ]; then
    row dcg off "left out of the check (--no-dcg)"
  else
    dcg_path=$(find_dcg)
    if [ -n "$dcg_path" ]; then row dcg ok "$dcg_path"; else row dcg missing "not installed: run ./dcg/install.sh (./setup --check --no-dcg leaves it out)"; fi
  fi

  hooked=0
  if [ -e "$CFG/settings.json" ] && [ -n "$dcg_path" ]; then dcg_hooked "$CFG/settings.json" || hooked=$?; fi
  if [ ! -e "$CFG/settings.json" ]; then row settings missing "no settings.json: run ./setup to seed it"
  elif [ "$hooked" != 0 ]; then row settings missing "$(dcg_hook_fix "$hooked")"
  else row settings ok "$CFG/settings.json"
  fi
  overlay_row check
  skill_plugins_row check

  claude_row
  if claude_usable; then
    rc=0; marketplace_listed || rc=$?
    case "$rc" in
      0) row marketplace ok "$MARKETPLACE is added" ;;
      3) row marketplace missing "$MARKETPLACE is not added: run ./setup" ;;
      *) row marketplace unknown "could not read 'claude plugin marketplace list --json'" ;;
    esac
    rc=0; have=$(installed_plugins) || rc=$?
    if [ "$rc" -ne 0 ]; then
      row plugins unknown "could not read 'claude plugin list --json'"
    else
      absent=""
      for p in "${defaults[@]}"; do
        [ -n "$(version_of "$p" "$have")" ] || absent="$absent $p"
      done
      if [ -n "$absent" ]; then row plugins missing "not installed:$absent; run ./setup"
      else row plugins ok "${defaults[*]}"; fi
    fi
  else
    row marketplace skipped "needs Claude Code $CLAUDE_FLOOR or later on PATH"
    row plugins skipped "needs Claude Code $CLAUDE_FLOOR or later on PATH"
  fi

  instructions_row --check
  printf '%s\n' "${rows[@]}"
  if [ "$not_ok" -eq 0 ]; then
    echo "hov-stack --check: every step is in place."
    exit 0
  fi
  echo "hov-stack --check: $not_ok not in place."
  exit 1
fi

mkdir -p "$CFG/skills"
echo "hov-stack: linking $HOV_STACK into $CFG"
[ ${#skip_lines[@]} -eq 0 ] || printf '%s\n' "${skip_lines[@]}"
linked=0
unlinked=0
i=0
while [ "$i" -lt "${#srcs[@]}" ]; do
  if link_file "${srcs[i]}" "${dsts[i]}" "$BACKUP"; then linked=$((linked + 1)); else unlinked=$((unlinked + 1)); fi
  i=$((i + 1))
done
if [ "$unlinked" -eq 0 ]; then echo "  $linked links in place"; fi
overlay_import || echo "  could not import $OVERLAY/CLAUDE.md from $(_lf_display "$OVERLAY_RULE") (see above)"
[ -d "$BACKUP" ] && echo "  replaced files were moved to $BACKUP (nothing was deleted)"
if [ "$unlinked" -eq 0 ]; then row links ok "$linked links in place"; else row links failed "$unlinked could not be made (see above)"; fi
commands_row run

if [ "$no_dcg" = 1 ]; then
  echo "dcg: skipped (--no-dcg). Run ./dcg/install.sh to add it later, then re-run ./setup."
  row dcg off "--no-dcg: ./dcg/install.sh adds it later"
else
  # OQ4: the licence, before anything is downloaded.
  echo "dcg, the destructive-command guard, is MIT-licensed with an added rider that GitHub's"
  echo "licence detection does not recognise: it grants no rights to OpenAI or Anthropic, their"
  echo "affiliates, or anyone acting for them. Read it at"
  echo "  $DCG_LICENSE"
  echo "To leave dcg out, run ./setup --no-dcg instead."
  rc=0
  bash "$HOV_STACK/dcg/install.sh" || rc=$?
  case "$rc" in
    0) row dcg ok "$(find_dcg)" ;;
    3) row dcg skipped "see the 'dcg: skipped' lines above; run ./dcg/install.sh once that is fixed, then re-run ./setup" ;;
    *) row dcg failed "dcg/install.sh exited $rc and installed nothing; see the 'dcg: error' line above" ;;
  esac
fi

dcg_path=$(find_dcg)
seed_target=$CFG/settings.json
# A settings.json an earlier run seeded before dcg was installed, unedited since, lacks the
# hook only because dcg was absent then: move it aside and seed it again with the hook (#371).
moved_seed=
if [ -n "$dcg_path" ] && [ -f "$seed_target" ] && [ ! -L "$seed_target" ] \
  && ! dcg_hooked "$seed_target" && untouched_seed "$seed_target"; then
  rel=${seed_target#"$HOME"/}
  [ "$rel" != "$seed_target" ] || rel=$(basename "$seed_target")
  if mkdir -p "$BACKUP/$(dirname "$rel")" && mv "$seed_target" "$BACKUP/$rel"; then
    moved_seed=$BACKUP/$rel
    echo "  backed up $(_lf_display "$seed_target") -> $moved_seed: it was an earlier run's seed, unedited and written before dcg was installed, so it is seeded again with dcg's hook"
  fi
fi
if [ -e "$seed_target" ] || [ -L "$seed_target" ]; then
  seed_target=$CFG/settings.hov-stack.json
  echo "  settings.json already exists and was left alone; the hov-stack seed is at $seed_target"
fi
if node "$HOV_STACK/lib/settings-seed.js" "$HOV_STACK/settings.json" "$seed_target" "$CFG" "$HOME" "$dcg_path" "$overlay_settings"; then
  seed_ok=1
  hooked=0
  if [ -n "$moved_seed" ] && ! carry_claude_writes "$moved_seed" "$seed_target"; then
    row settings failed "seeded $seed_target with dcg's hook, but could not copy the plugin keys Claude Code had written from $moved_seed; copy enabledPlugins and extraKnownMarketplaces from it"
  else
    if [ -n "$dcg_path" ] && [ "$no_dcg" = 0 ]; then dcg_hooked "$CFG/settings.json" || hooked=$?; fi
    if [ "$hooked" != 0 ]; then row settings missing "$(dcg_hook_fix "$hooked")"
    else row settings ok "seed written to $seed_target"
    fi
  fi
else
  # Never leave the config dir without the settings.json an upgrade moved aside. Anything at
  # seed_target now is this run's own failed write (the old file was moved away just above),
  # so the old one goes back over it.
  if [ -n "$moved_seed" ] && mv -f -- "$moved_seed" "$seed_target"; then
    echo "  put $(_lf_display "$seed_target") back from $moved_seed: the new seed was not written"
  fi
  row settings failed "lib/settings-seed.js wrote no seed; the lines above say why"
fi
overlay_row run
skill_plugins_row run
if [ -z "$dcg_path" ]; then
  echo "  dcg (the destructive-command guard) is not installed, so its hook was left out."
  echo "  It is the one third-party guard this setup leans on:"
  echo "    https://github.com/Dicklesworthstone/destructive_command_guard"
  echo "  Install it, then re-run ./setup: a settings.json this run seeded and nobody edited"
  echo "  gets the hook then; an edited one is left alone and the hook is in settings.hov-stack.json."
fi

claude_row
if ! claude_usable; then
  row marketplace skipped "needs Claude Code $CLAUDE_FLOOR or later on PATH; then re-run ./setup"
  row plugins skipped "needs the $MARKETPLACE marketplace"
else
  mk_rc=0
  marketplace_listed || mk_rc=$?
  mk_note="$MARKETPLACE was already added"
  add_rc=0
  if [ "$mk_rc" -eq 3 ]; then
    echo "hov-stack: adding the $MARKETPLACE marketplace from $MARKETPLACE_SOURCE"
    claude plugin marketplace add "$MARKETPLACE_SOURCE" || add_rc=$?
    if [ "$add_rc" -eq 0 ]; then
      mk_note="added from $MARKETPLACE_SOURCE"
      mk_rc=0
      marketplace_listed || mk_rc=$?
    fi
  fi
  if [ "$add_rc" -ne 0 ]; then
    row marketplace skipped "'claude plugin marketplace add $MARKETPLACE_SOURCE' exited $add_rc (offline?): run it when online, then re-run ./setup"
  elif [ "$mk_rc" -eq 3 ]; then
    row marketplace failed "$MARKETPLACE_SOURCE was added, but no marketplace named $MARKETPLACE is listed"
  elif [ "$mk_rc" -ne 0 ]; then
    row marketplace skipped "could not read 'claude plugin marketplace list --json': re-run ./setup"
  else
    row marketplace ok "$mk_note"
  fi

  if [ "$add_rc" -ne 0 ] || [ "$mk_rc" -ne 0 ]; then
    row plugins skipped "needs the $MARKETPLACE marketplace"
  else
    plugins_ready=1
    p_rc=0
    have=$(installed_plugins) || p_rc=$?
    not_added=""
    added=""
    if [ "$p_rc" -eq 0 ]; then
      for p in "${defaults[@]}"; do
        [ -z "$(version_of "$p" "$have")" ] || continue
        echo "hov-stack: installing $p@$MARKETPLACE"
        # No -y: it only confirms a command a marketplace entry declares, and no default declares one.
        if claude plugin install "$p@$MARKETPLACE" --scope user; then added="$added $p"; else not_added="$not_added $p"; fi
      done
      if [ -n "$added" ]; then have=$(installed_plugins) || p_rc=$?; fi
    fi
    if [ "$p_rc" -ne 0 ]; then
      row plugins skipped "could not read 'claude plugin list --json': re-run ./setup"
    elif [ -n "$not_added" ]; then
      row plugins skipped "not installed:$not_added (offline?): run 'claude plugin install <name>@$MARKETPLACE' for each when online, then re-run ./setup"
    elif [ -n "$added" ]; then
      row plugins ok "installed:$added"
    else
      row plugins ok "${defaults[*]} were already installed"
    fi
    # Claude Code leaves auto-update off for a marketplace from another publisher, and every
    # 'marketplace add' drops the setting, so it is set again after the add (#395). Only in
    # setup's own unedited seed (with this run's dcg hook, or the one written before dcg was
    # installed): the README promises to leave a settings.json you have alone, so for yours
    # setup only reports, and /hov-setup asks before turning it on. No status row, so
    # --check and the exit status do not change.
    au_helper=$HOV_STACK/plugins/hov-stack/skills/hov-setup/scripts/autoupdate.mjs
    au_rc=0
    if untouched_seed "$CFG/settings.json" "$dcg_path" \
      || { [ -n "$dcg_path" ] && untouched_seed "$CFG/settings.json"; }; then
      au_out=$(node "$au_helper" --config-dir "$CFG" --no-backup "$MARKETPLACE" 2>&1) || au_rc=$?
      printf '%s\n' "$au_out" | sed 's/^/  /'
    else
      au_out=$(node "$au_helper" --config-dir "$CFG" --check "$MARKETPLACE" 2>&1) || au_rc=$?
      printf '%s\n' "$au_out" | sed 's/^/  /'
      if [ "$au_rc" -eq 3 ]; then
        echo "  setup does not change a settings.json you already have; /hov-setup asks before it does."
      fi
    fi
    if [ "$au_rc" -eq 0 ]; then au_on=1; fi
  fi
fi

if [ "$update" = 1 ]; then
  if [ "$plugins_ready" = 1 ]; then
    update_plugins
  else
    urow refresh skipped "needs Claude Code $CLAUDE_FLOOR or later and the $MARKETPLACE marketplace; then re-run ./setup --update"
  fi
  update_programs
  update_uv_tools
  # jsm's skills are the user's paid account: setup names the command and leaves it to them.
  if command -v jsm >/dev/null 2>&1; then
    echo "hov-stack: jsm's skills are not updated here. To update them, run: jsm upgrade"
  fi
fi

instructions_row
echo "hov-stack: status"
printf '%s\n' "${rows[@]}"
echo "  left alone on purpose: memory, projects/, credentials, settings.local.json, shell rc files."
echo "hov-stack: done in $(( $(date +%s) - T0 ))s. ./setup --check shows what is in place."
# The status block above in plain words, for someone who has never set up Claude Code tools,
# then the one next step. A first-time user read the rows alone as jargon (U26, 2026-11-03).
echo
echo "What you have now:"
have_any=0
if [ "$st_links" = ok ]; then
  echo "  - The rules and safety checks every new Claude Code session loads, linked from this folder."
  have_any=1
fi
if [ "$st_commands" = ok ]; then
  echo "  - Commands that read Search Console, Analytics, Stripe and other services (gsc, ga4,"
  echo "    stripe-api and the rest), run by name. Each needs that service's own key first."
  have_any=1
fi
if [ "$st_dcg" = ok ]; then
  echo "  - dcg, which stops a command that would wipe files or git history before it runs."
  have_any=1
fi
if [ "$st_plugins" = ok ]; then
  names=""
  for i in "${!defaults[@]}"; do
    if [ "$i" -eq 0 ]; then names=${defaults[0]}
    elif [ "$i" -eq $(( ${#defaults[@]} - 1 )) ]; then names="$names and ${defaults[$i]}"
    else names="$names, ${defaults[$i]}"; fi
  done
  echo "  - The plugins setup installs for everyone: $names. /hov-setup shows what each does."
  have_any=1
fi
if [ "$au_on" = 1 ]; then
  echo "  - Auto-update for the $MARKETPLACE plugins: Claude Code fetches their new versions by itself."
fi
[ "$have_any" -eq 1 ] || echo "  - Nothing yet: the rows above say what stopped each step."
if [ "$not_ok" -eq 1 ]; then
  echo "  1 step above is not finished; its row says how to finish it, then run ./setup again."
elif [ "$not_ok" -gt 1 ]; then
  echo "  $not_ok steps above are not finished; each row says how to finish it, then run ./setup again."
fi
echo
if [ "$st_claude" = ok ]; then
  echo "Next: open a new Claude Code session (it reads the rules and checks only when it starts)"
  echo "  and type /hov-setup. It explains, in plain words, the optional plugins and the other"
  echo "  tools hov-stack works with, and sets up the ones you pick, all in that one session."
else
  echo "Next: get Claude Code working (the claude row above says how) and run ./setup again."
  echo "  Then open Claude Code and type /hov-setup for the optional plugins and tools."
fi
exit "$failed"
