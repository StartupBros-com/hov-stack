# Windows OpenSSH template
# Keep shared SSH defaults here; private hosts extend this template through
# ~/.ssh/config.local or ~/.ssh/config.local.d/*.conf.

Include ~/.ssh/config.local
Include ~/.ssh/config.local.d/*.conf

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_rsa
    IdentitiesOnly yes

